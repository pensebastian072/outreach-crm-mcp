# HQ Outreach MCP Configuration
# Copy to .env and fill in your actual values

# Azure OAuth Configuration
TENANT_ID=your_tenant_id_here
CLIENT_ID=your_client_id_here

# Database
DATABASE_PATH=./data/outreach.db

# Apollo.io Integration (for professional email delivery)
# Get key from: https://apollo.io/settings/api-keys
APOLLO_API_KEY=your_apollo_key_here

# Instantly.ai Integration (for email warm-up)
# Get key from: https://instantly.ai/app/settings/api-tokens
INSTANTLY_API_KEY=your_instantly_key_here

# Email Configuration
THOMAS_CALENDLY_LINK=https://calendly.com/thomas/30min

# Optional: Event details injected into drafts
# (Can also be imported from data/Earth X context.txt)
EVENT_DATE=Month DD-DD, YYYY
EVENT_LOCATION=Your Venue
EVENT_CITY=Your City
EVENT_EXPECTED_ATTENDEES=10000

# Optional: Logging Level
LOG_LEVEL=info

# Google Gmail / Calendar / People API Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/gmail/callback
GOOGLE_PROJECT_ID=your-google-project-id
GOOGLE_PUBSUB_TOPIC=projects/your-project-id/topics/your-topic
APP_PUBLIC_URL=https://your-app-url

# Optional: encrypt stored OAuth tokens
TOKEN_ENCRYPTION_KEY=change-me
