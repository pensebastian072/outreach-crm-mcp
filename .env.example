# Microsoft Graph API Configuration
# Register your app at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade

# Your Azure AD Tenant ID (found in Azure Portal > Azure Active Directory > Overview)
MS_TENANT_ID=your-tenant-id-here

# Your Application (client) ID (found in Azure Portal > App registrations > your app > Overview)
MS_CLIENT_ID=your-client-id-here

# Email address to send from (must have permission in your tenant)
MS_SENDER_EMAIL=your-email@yourdomain.com

# Required API Permissions (configure in Azure Portal > App registrations > your app > API permissions):
# - Mail.ReadWrite
# - Mail.Send
# - User.Read

# Google Gmail / Calendar / People API Configuration
# Create OAuth client in Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/gmail/callback
GOOGLE_PROJECT_ID=your-google-project-id
GOOGLE_PUBSUB_TOPIC=projects/your-project-id/topics/your-topic
APP_PUBLIC_URL=https://your-app-url

# Optional: encrypt stored OAuth tokens
TOKEN_ENCRYPTION_KEY=change-me
